{
  "name": "retro-tui",
  "version": "3.0.0",
  "description": "Terminal-aesthetic Lit components and tokens for building small app UIs.",
  "type": "module",
  "main": "dist/retro-tui.js",
  "module": "dist/retro-tui.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/retro-tui.js"
    },
    "./cdn": "./dist/retro-tui.cdn.js",
    "./tokens.css": {
      "import": "./dist/tokens.css",
      "types": "./dist/tokens.css.d.ts"
    },
    "./src/*": "./src/*"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:cdn && npm run build:types",
    "build:cdn": "vite build --config vite.cdn.config.js",
    "build:types": "tsc --emitDeclarationOnly --declaration",
    "build:site": "vite build --config vite.site.config.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "server": "node examples/push-server/server/index.js",
    "start": "concurrently \"npm run dev\" \"npm run server\"",
    "test": "vitest",
    "test:run": "vitest run",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "terminal",
    "tui",
    "web-components",
    "lit",
    "retro",
    "ascii"
  ],
  "author": "Brandon",
  "license": "MIT",
  "dependencies": {
    "lit": "^3.1.0"
  },
  "devDependencies": {
    "@open-wc/testing": "^4.0.0",
    "concurrently": "^8.2.0",
    "jsdom": "^27.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^4.0.18",
    "ws": "^8.16.0"
  },
  "directories": {
    "doc": "docs",
    "example": "examples"
  }
}
